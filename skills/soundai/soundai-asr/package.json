{
  "name": "soundai-asr-provider",
  "version": "1.0.2",
  "private": true,
  "description": "OpenClaw SoundAI media-understanding provider",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "package.json"
  ],
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=esm --external:openclaw/* --outfile=dist/index.js"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.0"
    },
    "build": {
      "openclawVersion": "2026.3.28"
    }
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "esbuild": "^0.27.4",
    "typescript": "^6.0.2"
  }
}
